{
  "name": "Node Red",
  "description": "Node-RED is a flow-based programming tool for wiring together hardware devices, APIs and online services.",
  "extends": "oci-image",
  "icon": "icon.svg",
  "properties": [
    { "id": "hostname", "default": "node-red" },
    { "id": "volumes", "default": "data=data,size=512M\ncerts=certs" },
    { "id": "envs", "default": "GID=1000\nNODERED_PORT=1880\nNODERED_VERSION=latest\nTZ=Europe/Berlin\nUID=1000" },
    { "id": "oci_image", "value": "nodered/node-red:{{oci_image_tag}}" },
    { "id": "uid", "value": "1000" },
    { "id": "username", "value": "root" },
    { "id": "ssl.needs_ca_cert", "value": "true" },
    { "id": "ssl.needs_server_cert", "value": "true" },
    {
      "id": "oidc_redirect_uri",
      "default": "https://{{hostname}}{{project_domain_suffix}}:1880/auth/strategy/callback"
    },
    {
      "id": "oidc_post_logout_uri",
      "default": "https://{{hostname}}{{project_domain_suffix}}:1880/"
    }
  ],
  "installation": {
    "pre_start": [
      "110-conf-map-serial.json",
      "0-upload-settings-js.json",
      "1-upload-flows-json.json"
    ]
  },
  "reconfigure": {
    "pre_start": [
      "110-conf-map-serial.json"
    ]
  },
  "source": "https://github.com/node-red/node-red-docker",
  "tags": [
    "api",
    "development"
  ],
  "supported_addons": ["addon-oidc", "addon-mtls"],
  "oidc_roles": [
    { "key": "admin", "display_name": "Administrator" }
  ]
}
