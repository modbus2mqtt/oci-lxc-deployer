{
  "name": "Cloudflare Tunnel",
  "description": "Cloudflared connector for a remotely-managed Cloudflare Tunnel, run as a Docker Compose service. Establishes an outbound-only connection to Cloudflare's edge; all ingress/public-hostname routing (e.g. git.ohnewarum.de, auth.ohnewarum.de, ohnewarum.de) is configured in the Cloudflare Zero Trust dashboard, not in this application.",
  "extends": "docker-compose",
  "tags": [
    "network",
    "infrastructure"
  ],
  "supported_addons": [],
  "properties": [
    { "id": "hostname", "default": "cloudflare-tunnel" },
    { "id": "compose_project", "value": "cloudflare-tunnel" },
    { "id": "compose_file", "value": "" }
  ],
  "stacktype": "cloudflare-tunnel",
  "stack_usage": [
    {
      "stacktype": "cloudflare-tunnel",
      "vars": [
        {
          "name": "TUNNEL_TOKEN",
          "replacement": "compose-env",
          "compose_key": "TUNNEL_TOKEN"
        }
      ]
    }
  ],
  "check": {
    "check": [
      "check-tunnel-connected.json"
    ]
  },
  "url": "https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/",
  "documentation": "https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/do-more-with-tunnels/local-management/as-a-service/docker/",
  "source": "https://github.com/cloudflare/cloudflared"
}
