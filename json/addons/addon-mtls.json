{
  "name": "mTLS Client Certificates",
  "description": "Issue per-user client certificates signed by the project root CA into the mtls/<CN>/ subdir of the app's certs volume.",
  "tags": [
    "security",
    "network"
  ],
  "parameters": [
    "mtls_cns"
  ],
  "properties": [
    {
      "id": "mtls.check_file_paths",
      "value": "/certs/mtls/{{ hostname }}/cert.pem"
    }
  ],
  "installation": {
    "pre_start": [
      { "name": "161-conf-generate-mtls-certs.json", "position": "end" },
      { "name": "162-conf-enable-mtls-app.json", "position": "end" },
      { "name": "163-conf-create-mtls-db-roles.json", "position": "end" }
    ]
  },
  "reconfigure": {
    "pre_start": [
      { "name": "161-conf-generate-mtls-certs.json", "position": "end" },
      { "name": "162-conf-enable-mtls-app.json", "position": "end" },
      { "name": "163-conf-create-mtls-db-roles.json", "position": "end" }
    ]
  },
  "disable": {
    "pre_start": []
  },
  "upgrade": [],
  "check": [
    "940-host-check-file-exists.json"
  ],
  "notes_key": "mtls"
}
